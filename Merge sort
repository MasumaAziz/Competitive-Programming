#include <iostream>
using namespace std;

//sorting and merging
void merge(int arr[],int first,int mid,int last)
{
    int i=first;
    int j=mid+1;
    int k=first;
    int temp[1000];

    while(i<=mid && j<=last)
    {
        if(arr[i]<=arr[j])
        {
            temp[k]=arr[i];
            i++;
            k++;
        }
        else
        {
            temp[k]=arr[j];
            j++;
            k++;
        }
    }
    if(i>mid)
    {
        while(j<=last)
        {
            temp[k]=arr[j];
            j++;
            k++;
        }
    }
    else
    {
        while(i<=mid)
        {
            temp[k]=arr[i];
            i++;
            k++;
        }
    }
    for(k=first; k<=last; k++)
    {
        arr[k]=temp[k];
    }
}

//merge sort function
void mergeSort(int arr[], int first, int last)
{
    if (first < last)
    {
        int mid = (first + last) / 2;

        mergeSort(arr, first, mid); //sort left array
        mergeSort(arr, mid + 1, last); //sort right array

        merge(arr, first, mid, last); //merge two halves
    }
}

int main()
{
    int n;
    cout<<"Enter the size of array: ";
    cin>>n;
    int arr[n];
    cout<<"Enter array elements: ";
    for(int i=0; i<n; i++)
    {
        cin>>arr[i];
    }
    cout << "Original Array: ";
    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }

    mergeSort(arr, 0, n - 1);

    cout <<endl<< "Sorted Array: ";
    for (int i = 0; i < n; i++)
        cout << arr[i] << " ";

    return 0;
}
